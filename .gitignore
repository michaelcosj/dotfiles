.api_key.*
.env
.opencode/
/config/

# Generated dependency trees and root-level lockfiles
node_modules/
/nix/package-lock.json

# Nix build output
/result

# Herdr runtime state and downloaded plugins
/nix/config/herdr/.plugins.lock
/nix/config/herdr/*.log
/nix/config/herdr/release-notes.json
/nix/config/herdr/session.json
/nix/config/herdr/plugins/github/
/nix/config/opencode/plugins/herdr-agent-state.js

# Pi runtime state. home/pi.nix moves it to ~/.pi on the next switch
# (scripts/migrate-pi-state); keep these until every machine has switched.
/nix/config/pi/.agent/
/nix/config/pi/pi-acp/session-map.json
/nix/config/pi/agent/auth.json
/nix/config/pi/agent/mcp-auth.json
/nix/config/pi/agent/mcp.log*
/nix/config/pi/agent/cached-compaction.jsonl
/nix/config/pi/agent/fff/
/nix/config/pi/agent/git/
/nix/config/pi/agent/models-store.json
/nix/config/pi/agent/npm/
/nix/config/pi/agent/pi-web-access/
/nix/config/pi/agent/plans/
/nix/config/pi/agent/sessions/
/nix/config/pi/agent/state/
/nix/config/pi/agent/trust.json
/nix/config/pi/agent/workflow-plan.md
/nix/config/herdr/*.sock*
/nix/config/herdr/session-snapshots/

# Opencode server credentials
/nix/config/opencode/service.json

# Local research notes and investigation reports
/reports/
/research_notes/
