#!/usr/bin/env bun
// rex-view: Markdown pages in a Rex pane; Chrome only for one-shot screenshots.
//
//   rex-view show [--below] [--ratio PCT] [--focus] FILE|-   open or update Markdown
//   rex-view wait [--timeout SEC] [--close]                print a submitted answer as JSON
//   rex-view shot [-o FILE.txt]                           capture the pane as text
//   rex-view hide                                        close the pane
//   rex-view status                                      print the pane's state as JSON
//   rex-view view FILE                                   run the tui viewer in this terminal
//   rex-view snap URL|FILE [-o OUT.png] [--size WxH]       screenshot (default 1280x800)
//   rex-view help                                        show this help
//
// All commands accept --name NAME (or REX_VIEW_NAME) and --state DIR.
// show - reads Markdown from stdin. wait --close closes after an answer or timeout.
// snap uses REX_VIEW_CHROME when set; its default output is STATE/snap.png.

import { mkdtempSync, mkdirSync, writeFileSync, rmSync, existsSync, readFileSync, unlinkSync } from "node:fs";
import { tmpdir, homedir } from "node:os";
import { join, resolve, dirname, basename } from "node:path";
import { pathToFileURL } from "node:url";

// Nix puts Chrome on PATH, not in /usr/bin.
const CHROME = process.env.REX_VIEW_CHROME ||
  ["/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
   "/Applications/Chromium.app/Contents/MacOS/Chromium"].find(existsSync) ||
  ["google-chrome-stable", "google-chrome", "chromium", "chromium-browser"].map(n => Bun.which(n)).find(Boolean);
const die = (msg, code = 1) => { console.error("rex-view: " + msg); process.exit(code); };
const COMMANDS = ["show", "wait", "shot", "hide", "status", "view", "snap", "help"];
const argv = process.argv.slice(2), rest = [];
const opt = { ratio: "50", below: false, focus: false, timeout: 0, close: false, out: "", size: "1280x800",
  name: process.env.REX_VIEW_NAME || "", state: "" };
let cmd = "";
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  const value = () => argv[++i] || die(`missing value for ${a}`, 2);
  if (a === "--ratio") opt.ratio = value();
  else if (a === "--below") opt.below = true;
  else if (a === "--focus") opt.focus = true;
  else if (a === "--timeout") opt.timeout = Number(value());
  else if (a === "--close") opt.close = true;
  else if (a === "-o" || a === "--output") opt.out = value();
  else if (a === "--name") opt.name = value();
  else if (a === "--state") opt.state = value();
  else if (a === "--size") opt.size = value();
  else if (a === "-h" || a === "--help") cmd = "help";
  else if (a.startsWith("-") && a !== "-") die(`unknown option: ${a}`, 2);
  else if (!cmd && !rest.length && COMMANDS.includes(a)) cmd = a;
  else rest.push(a);
}
cmd ||= "view";
if (cmd === "help") {
  const lines = readFileSync(import.meta.path, "utf8").split("\n").slice(1);
  console.log(lines.slice(0, lines.findIndex(l => !l.startsWith("//"))).map(l => l.replace(/^\/\/ ?/, "")).join("\n"));
  process.exit(0);
}

const stateRoot = join(process.env.XDG_STATE_HOME || join(homedir(), ".local/state"), "rex-view");
const viewerName = (opt.name || (process.env.REX_BLOCK || "default").replace(/^block:/, "").slice(-12)).replace(/[^\w.-]/g, "_");
const stateDir = resolve(opt.state || join(stateRoot, viewerName));
const sockPath = join(stateDir, "sock");
const TUI_DIR = resolve(dirname(import.meta.path), "../tui");
const TUI_VIEW = join(TUI_DIR, "view.ts");

function tuiReady() {
  if (existsSync(join(TUI_DIR, "node_modules/@opentui/core/package.json"))) return;
  const p = Bun.spawnSync([process.execPath, "install", "--frozen-lockfile"], { cwd: TUI_DIR, stdout: "ignore", stderr: "pipe" });
  if (p.exitCode) die("couldn't install the tui viewer's packages: " + p.stderr.toString().trim());
}
function toURL(target) {
  if (/^[a-z][a-z0-9+.-]*:\/\//i.test(target)) return target;
  const file = resolve(target);
  if (!existsSync(file)) die(`no such file: ${file}`);
  return pathToFileURL(file).href;
}
// Headless Nix hosts can lack /etc/fonts; use Home Manager's complete config.
function chromeEnv() {
  const env = { ...process.env };
  const own = join(process.env.XDG_CONFIG_HOME || join(homedir(), ".config"), "fontconfig", "fonts.conf");
  if (!env.FONTCONFIG_FILE && process.platform === "linux" && !existsSync("/etc/fonts/fonts.conf") && existsSync(own)) env.FONTCONFIG_FILE = own;
  return env;
}
async function api(path, body, timeoutMs = 10000) {
  const ctl = new AbortController(), t = timeoutMs ? setTimeout(() => ctl.abort(), timeoutMs) : 0;
  try {
    return await fetch("http://rex-view" + path, { unix: sockPath, method: body === undefined ? "GET" : "POST",
      body: body === undefined ? undefined : JSON.stringify(body), signal: ctl.signal });
  } finally { clearTimeout(t); }
}
async function alive() { try { return (await api("/status", undefined, 1500)).ok; } catch { return false; } }
async function closePane() {
  await api("/close", {}).catch(() => {});
  for (let t = 0; t < 30 && await alive(); t++) await Bun.sleep(100);
}

if (cmd === "view") {
  const file = rest[0] || die("usage: rex-view view FILE", 2);
  tuiReady();
  const p = Bun.spawn([process.execPath, TUI_VIEW, file], { stdin: "inherit", stdout: "inherit", stderr: "inherit" });
  process.exit(await p.exited);
}
mkdirSync(stateDir, { recursive: true });
if (cmd === "snap") {
  const target = rest[0] || die("usage: rex-view snap URL|FILE [-o OUT.png] [--size WxH]", 2);
  if (!CHROME) die("Chrome not found; set REX_VIEW_CHROME");
  if (!/^[1-9]\d*x[1-9]\d*$/.test(opt.size)) die("size must be WxH with positive integers", 2);
  const url = toURL(target), out = resolve(opt.out || join(stateDir, "snap.png"));
  const profile = mkdtempSync(join(tmpdir(), "rex-view-profile-"));
  let error = "";
  try {
    const p = Bun.spawnSync([CHROME, "--headless=new", "--disable-gpu", "--hide-scrollbars", `--screenshot=${out}`,
      `--window-size=${opt.size.replace("x", ",")}`, `--user-data-dir=${profile}`, url],
      { stdout: "ignore", stderr: "pipe", env: chromeEnv() });
    if (p.exitCode || !existsSync(out)) error = p.stderr.toString().trim().split("\n").slice(-20).join("\n") || "Chrome did not write a screenshot";
  } catch (e) { error = e.message; }
  finally { rmSync(profile, { recursive: true, force: true }); }
  if (error) die(error);
  console.log(out);
  process.exit(0);
}
if (cmd === "show") {
  let target = rest[0] || die("usage: rex-view show FILE|-", 2);
  if (/^[a-z][a-z0-9+.-]*:\/\//i.test(target)) die("rex-view shows Markdown files; for a web page use 'rex-view snap URL'");
  const stdin = target === "-", base = stdin ? process.cwd() : dirname(resolve(target));
  if (!stdin && !existsSync(resolve(target))) die(`no such file: ${resolve(target)}`);
  const text = stdin ? await Bun.stdin.text() : readFileSync(resolve(target), "utf8");
  if (text.trimStart().startsWith("<")) die("rex-view shows Markdown; see the visualise skill (HTML pages are gone)");
  if (stdin) { target = join(stateDir, "page.md"); writeFileSync(target, text); }
  target = resolve(target);
  const url = pathToFileURL(target).href;
  if (await alive()) {
    const r = await api("/open", { url, base });
    if (!r.ok) die(await r.text());
    if (opt.focus) Bun.spawnSync(["rex", "block", "focus", readFileSync(join(stateDir, "block"), "utf8").trim()]);
    console.log(`rex-view: updated ${viewerName}`);
    process.exit(0);
  }
  if (!process.env.REX_BLOCK && !process.env.REX_SESSION) die("show needs a Rex terminal; use 'rex-view view' in other terminals");
  tuiReady();
  try { unlinkSync(sockPath); } catch {}
  // A hidden agent pane cannot be split; use the focused pane instead.
  let anchor = process.env.REX_BLOCK || "";
  if (anchor) {
    const p = Bun.spawnSync(["rex", "block", "inspect", anchor, "--json"], { stdout: "pipe", stderr: "ignore" });
    try { if (JSON.parse(p.stdout.toString()).block?.placement !== "placed") anchor = ""; } catch { anchor = ""; }
  }
  const viewer = [process.execPath, TUI_VIEW, "--name", viewerName, "--state", stateDir, "--base", base, target];
  const split = ["rex", "split", "--json", "--ratio", String(opt.ratio), "--split", opt.below ? "below" : "right",
    `--focus=${opt.focus}`, "--label", basename(target), "--shell=none", ...(anchor ? ["-b", anchor] : []), "--",
    // rex split does not pass this process's environment to the pane.
    ...(process.env.REX_VIEW_DEBUG ? ["env", `REX_VIEW_DEBUG=${process.env.REX_VIEW_DEBUG}`] : []), ...viewer];
  const env = { ...process.env };
  if (!anchor) delete env.REX_BLOCK;
  const p = Bun.spawnSync(split, { stdout: "pipe", stderr: "pipe", env });
  if (p.exitCode) die("rex split failed: " + p.stderr.toString());
  const block = JSON.parse(p.stdout.toString()).block_ids?.[0] || "";
  writeFileSync(join(stateDir, "block"), block + "\n");
  for (let t = 0; t < 100 && !(await alive()); t++) await Bun.sleep(100);
  if (!(await alive())) die("viewer did not start; try REX_VIEW_DEBUG=/tmp/rex-view.log");
  console.log(`rex-view: showing ${basename(target)} in ${block} (name ${viewerName})`);
  process.exit(0);
}
if (!(await alive())) {
  if (cmd === "hide") process.exit(0);
  if (cmd === "status") { console.log(JSON.stringify({ name: viewerName, open: false })); process.exit(0); }
  die(`no open viewer '${viewerName}'; run 'rex-view show' first`);
}
if (cmd === "status") { console.log(await (await api("/status")).text()); process.exit(0); }
if (cmd === "hide") { await closePane(); process.exit(0); }
if (cmd === "shot") {
  const block = readFileSync(join(stateDir, "block"), "utf8").trim();
  const p = Bun.spawnSync(["rex", "capture", "-b", block, "--trim"], { stdout: "pipe", stderr: "pipe" });
  if (p.exitCode) die("rex capture failed: " + p.stderr.toString());
  const out = resolve(opt.out ? opt.out.replace(/\.png$/i, ".txt") : join(stateDir, "shot.txt"));
  writeFileSync(out, p.stdout);
  console.log(out);
  process.exit(0);
}
if (cmd === "wait") {
  let r;
  try { r = await api("/wait?timeout=" + (opt.timeout || 0), {}, 0); }
  catch { die("the viewer closed before anything was sent", 3); }
  if (r.status === 408) { if (opt.close) await closePane(); die("timed out", 124); }
  if (r.status === 410) die("the viewer closed before anything was sent", 3);
  console.log(await r.text());
  if (opt.close) await closePane();
}
