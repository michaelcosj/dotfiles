{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "small_model": "opencode/big-pickle",
  "warming": true,
  "enabled_providers": [
    "anthropic",
    "openai",
    "opencode"
  ],
  "references": {
