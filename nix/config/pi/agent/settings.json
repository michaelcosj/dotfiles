{
  "lastChangelogVersion": "0.84.1",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "low",
  "hideThinkingBlock": false,
  "shellCommandPrefix": "shopt -s expand_aliases\neval \"$(grep -E '^[[:space:]]+alias[[:space:]]+' ~/.config/fish/config.fish | sed -E \"s/^[[:space:]]+alias[[:space:]]+([^ ]+)[[:space:]]+'([^']*)'[[:space:]]*$/alias \\\\1='\\\\2'/;s/^[[:space:]]+alias[[:space:]]+([^ ]+)[[:space:]]+([^ ]+)[[:space:]]*$/alias \\\\1='\\\\2'/\")\"",
  "compaction": {
    "enabled": true,
    "reserveTokens": 65536,
    "keepRecentTokens": 20000
  },
  "theme": "pizza-ui",
  "quietStartup": true,
  "collapseChangelog": true,
  "showCacheMissNotices": true,
  "terminal": {
    "showTerminalProgress": true,
    "imageWidthCells": 80
  },
  "packages": [
    "npm:pi-web-access",
    "npm:@ff-labs/pi-fff"
  ],
  "enabledModels": [
    "openai-codex/gpt-5.4-mini",
    "openai-codex/gpt-5.5",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "opencode/big-pickle",
    "opencode-go/hy3",
    "opencode-go/glm-5.2",
    "opencode-go/kimi-k3",
    "opencode-go/minimax-m3",
    "opencode-go/qwen3.7-max",
    "opencode-go/qwen3.7-plus",
    "opencode-go/deepseek-v4-flash",
    "opencode-go/grok-4.5",
    "opencode-go/mimo-v2.5",
    "opencode-go/mimo-v2.5-pro",
    "opencode-go/gpt-5.6-luna"
  ],
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-5.3-codex-spark"
      }
    },
    "watchdog": {
      "main": {
        "enabled": true
      },
      "enabled": true
    }
  },
  "tuiMode": "fullscreen"
}