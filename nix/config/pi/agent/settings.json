{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "low",
  "hideThinkingBlock": true,
  "shellCommandPrefix": "shopt -s expand_aliases\neval \"$(grep -E '^[[:space:]]+alias[[:space:]]+' ~/.config/fish/config.fish | sed -E \"s/^[[:space:]]+alias[[:space:]]+([^ ]+)[[:space:]]+'([^']*)'[[:space:]]*$/alias \\\\1='\\\\2'/;s/^[[:space:]]+alias[[:space:]]+([^ ]+)[[:space:]]+([^ ]+)[[:space:]]*$/alias \\\\1='\\\\2'/\")\"",
  "compaction": {
    "enabled": true,
    "reserveTokens": 65536,
    "keepRecentTokens": 20000,
    "modelOverrides": {
      "claude-code/claude-opus-5-5": {
        "reserveTokens": 600000
      }
    }
  },
  "quietStartup": "header",
  "collapseChangelog": true,
  "showCacheMissNotices": true,
  "terminal": {
    "showTerminalProgress": true,
    "imageWidthCells": 80
  },
  "packages": [
    "npm:pi-web-access",
    "npm:@ff-labs/pi-fff",
    "git:github.com/michaelcosj/pi-claude-code@personal",
    "git:github.com/michaelcosj/pi-cached-compaction@132e0da268def8f6ae18c25c8b100497a54a589e"
  ],
  "tuiMode": "fullscreen",
  "showHardwareCursor": false,
  "editorPaddingX": 0,
  "modelThinkingLevels": {
    "openai/gpt-6.1-sol": "medium",
    "openai/gpt-6-astra": "low",
    "claude-code/claude-opus-5-5": "medium",
    "openai-codex/gpt-6.1-sol": "high"
  },
  "images": {
    "blockImages": false
  },
  "outputPad": 1,
  "cacheWarming": "streaming",
  "theme": "dark",
  "steeringMode": "all",
  "fullscreenExitOutput": "resume-hint",
  "enabledModels": [
    "openai-codex/gpt-6.1-sol",
    "claude-code/claude-opus-5-5",
    "opencode/claude-fable-5-2",
    "opencode-go/claude-haiku-5-5",
    "opencode/claude-sonnet-5-5",
    "openai-codex/gpt-6.1-terra",
    "openai-codex/gpt-6-luna"
  ]
}
