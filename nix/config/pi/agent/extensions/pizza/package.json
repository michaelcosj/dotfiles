{
  "name": "pizza",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "bun build ./src/index.ts --target=node --format=esm --minify --external=@earendil-works/pi-ai --external=@earendil-works/pi-coding-agent --external=@earendil-works/pi-tui --external=typebox --outfile=dist/index.js",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm test && npm run typecheck && npm run build"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
