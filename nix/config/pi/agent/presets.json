{
  "defaultPreset": "general",
  "defaultMode": "allow",
  "permission": {
    "allow": [
      "vcc_recall"
    ]
  },
  "presets": {
    "general": {
      "provider": "opencode-go",
      "model": "deepseek-v4-pro",
      "thinkingLevel": "high",
      "description": "Main agent with full permissions for general tasks",
      "permission": {
        "defaultMode": "allow"
      }
    },
    "brainstorm": {
      "provider": "opencode-go",
      "model": "deepseek-v4-flash",
      "thinkingLevel": "high",
      "instructions": "{file:./instructions/brainstorm.md}",
      "description": "Brainstorm agent - generates ideas, explores alternatives, and thinks creatively",
      "permission": {
        "defaultMode": "allow",
        "allow": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "switch_preset(plan)"
        ],
        "deny": [
          "edit",
          "todo",
          "search_text",
          "extract_content",
          "switch_preset"
        ],
        "ask": []
      }
    },
    "plan": {
      "provider": "github-copilot",
      "model": "gpt-5.4",
      "thinkingLevel": "high",
      "instructions": "{file:./instructions/plan.md}",
      "description": "Planning agent - creates detailed implementation plans without making changes",
      "permission": {
        "defaultMode": "ask",
        "allow": [
          "read",
          "grep",
          "find",
          "ls",
          "edit(.agent/*.md)",
          "bash",
          "switch_preset(explore)",
          "switch_preset(research)",
          "switch_preset(implement)"
        ],
        "deny": [
          "edit",
          "todo",
          "switch_preset"
        ],
        "ask": []
      }
    },
    "implement": {
      "provider": "github-copilot",
      "model": "gpt-5.3-codex",
      "thinkingLevel": "high",
      "instructions": "{file:./instructions/implement.md}",
      "description": "Implement agent - implements changes, runs build/test commands with bash and todo tools",
      "permission": {
        "defaultMode": "ask",
        "allow": [
          "read",
          "edit",
          "grep",
          "find",
          "ls",
          "bash",
          "todo",
          "switch_preset(review)"
        ],
        "deny": [
          "search_text",
          "extract_content",
          "switch_preset"
        ],
        "ask": []
      }
    },
    "research": {
      "provider": "opencode-go",
      "model": "deepseek-v4-flash",
      "thinkingLevel": "xhigh",
      "instructions": "{file:./instructions/research.md}",
      "description": "Research agent - use this to research and gather information using search and external content extraction",
      "permission": {
        "defaultMode": "allow",
        "allow": [
          "search_text",
          "extract_content",
          "read",
          "grep",
          "find",
          "ls",
          "bash(curl*)",
          "bash(wget*)",
          "switch_preset(plan)"
        ],
        "deny": [
          "edit",
          "todo",
          "switch_preset"
        ],
        "ask": [
          "bash"
        ]
      }
    },
    "review": {
      "provider": "github-copilot",
      "model": "gpt-5.4",
      "thinkingLevel": "xhigh",
      "instructions": "{file:./instructions/review.md}",
      "description": "Review agent - analyze code for issues, bugs, and quality concerns without making changes",
      "permission": {
        "defaultMode": "allow",
        "allow": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "switch_preset(implement)"
        ],
        "deny": [
          "edit",
          "todo",
          "search_text",
          "extract_content",
          "switch_preset"
        ],
        "ask": []
      }
    },
    "explore": {
      "provider": "opencode-go",
      "model": "deepseek-v4-flash",
      "thinkingLevel": "high",
      "instructions": "{file:./instructions/explore.md}",
      "description": "Explore agent - gather context and map codebase structure using readonly tools",
      "permission": {
        "defaultMode": "allow",
        "allow": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "switch_preset(plan)"
        ],
        "deny": [
          "edit",
          "todo",
          "search_text",
          "extract_content",
          "switch_preset"
        ],
        "ask": []
      }
    },
    "frontend-design": {
      "provider": "opencode-go",
      "model": "kimi-k2.6",
      "thinkingLevel": "high",
      "instructions": "{file:./instructions/frontend-design.md}",
      "description": "Frontend designer - designs and implements UI components and styling",
      "permission": {
        "defaultMode": "allow"
      }
    },
    "debug": {
      "provider": "github-copilot",
      "model": "gpt-5.4",
      "thinkingLevel": "xhigh",
      "instructions": "{file:./instructions/debug.md}",
      "description": "Debug agent - investigates bugs and finds root causes without making changes",
      "permission": {
        "defaultMode": "allow",
        "allow": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "switch_preset(implement)"
        ],
        "deny": [
          "edit",
          "todo",
          "search_text",
          "extract_content",
          "switch_preset"
        ],
        "ask": []
      }
    },
    "document": {
      "provider": "opencode-go",
      "model": "qwen3.5-plus",
      "thinkingLevel": "high",
      "instructions": "{file:./instructions/document.md}",
      "description": "Documentation agent - creates and updates project documentation",
      "permission": {
        "defaultMode": "allow",
        "allow": [
          "read",
          "edit",
          "write",
          "grep",
          "find",
          "ls",
          "bash",
          "todo",
          "switch_preset(review)"
        ],
        "deny": [
          "search_text",
          "extract_content",
          "switch_preset"
        ],
        "ask": []
      }
    }
  }
}
