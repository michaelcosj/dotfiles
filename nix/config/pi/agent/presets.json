{
  "defaultPreset": "pi",
  "defaultMode": "ask",
  "presets": {
    "pi": {
      "provider": "opencode-go",
      "model": "kimi-k2.6",
      "thinkingLevel": "high",
      "description": "Main agent with full permissions for general tasks",
      "permission": {
        "defaultMode": "allow"
      }
    },
    "plan": {
      "provider": "github-copilot",
      "model": "gpt-5.4",
      "thinkingLevel": "high",
      "instructions": "{file:./instructions/planning.md}",
      "description": "Planning agent - creates detailed implementation plans without making changes",
      "permission": {
        "defaultMode": "ask",
        "allow": [
          "read",
          "grep",
          "find",
          "ls",
          "edit(.agent/*.md)",
          "write(.agent/*.md)",
          "bash",
          "switch_preset(explore)",
          "switch_preset(research)",
          "switch_preset(implement)"
        ],
        "deny": [
          "edit",
          "write",
          "todo",
          "switch_preset"
        ],
        "ask": []
      }
    },
    "implement": {
      "provider": "github-copilot",
      "model": "gpt-5.3-codex",
      "thinkingLevel": "high",
      "instructions": "{file:./instructions/implement.md}",
      "description": "Implement agent - implements changes, runs build/test commands with bash and todo tools",
      "permission": {
        "defaultMode": "ask",
        "allow": [
          "read",
          "edit",
          "write",
          "grep",
          "find",
          "ls",
          "bash",
          "todo",
          "switch_preset(review)"
        ],
        "deny": [
          "search_text",
          "extract_content",
          "switch_preset"
        ],
        "ask": []
      }
    },
    "research": {
      "provider": "github-copilot",
      "model": "gpt-5.4-mini",
      "thinkingLevel": "xhigh",
      "instructions": "{file:./instructions/research.md}",
      "description": "Research agent - use this to research and gather information using search and external content extraction",
      "permission": {
        "defaultMode": "allow",
        "allow": [
          "search_text",
          "extract_content",
          "read",
          "grep",
          "find",
          "ls",
          "bash(curl*)",
          "bash(wget*)",
          "switch_preset(plan)"
        ],
        "deny": [
          "edit",
          "write",
          "todo",
          "switch_preset"
        ],
        "ask": [
          "bash"
        ]
      }
    },
    "review": {
      "provider": "github-copilot",
      "model": "gpt-5.4",
      "thinkingLevel": "xhigh",
      "instructions": "{file:./instructions/review.md}",
      "description": "Review agent - analyze code for issues, bugs, and quality concerns without making changes",
      "permission": {
        "defaultMode": "allow",
        "allow": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "switch_preset(implement)"
        ],
        "deny": [
          "edit",
          "write",
          "todo",
          "search_text",
          "extract_content",
          "switch_preset"
        ],
        "ask": []
      }
    },
    "explore": {
      "provider": "github-copilot",
      "model": "gpt-5.4-mini",
      "thinkingLevel": "high",
      "instructions": "{file:./instructions/explore.md}",
      "description": "Explore agent - gather context and map codebase structure using readonly tools",
      "permission": {
        "defaultMode": "allow",
        "allow": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "switch_preset(plan)"
        ],
        "deny": [
          "edit",
          "write",
          "todo",
          "search_text",
          "extract_content",
          "switch_preset"
        ],
        "ask": []
      }
    }
  }
}
