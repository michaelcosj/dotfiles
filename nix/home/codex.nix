# Codex (https://github.com/openai/codex). ~/.codex stays a real directory for
# Codex's runtime state: auth, sessions, sqlite stores, plugins, and caches.
# hooks.json and herdr-agent-state.sh are generated by herdr, so they stay
# untracked.
{ config, lib, ... }:
let
  repo = "${config.home.homeDirectory}/.dotfiles/nix/config/codex";
in
{
  home.file.".codex/AGENTS.md".source =
    config.lib.file.mkOutOfStoreSymlink "${repo}/AGENTS.md";

  # Codex writes machine-local state into config.toml, so seed the portable
  # defaults once instead of linking it. Existing files are left alone.
  home.activation.seedCodexConfig = lib.hm.dag.entryAfter [ "linkGeneration" ] ''
    if [ ! -e "$HOME/.codex/config.toml" ]; then
      run install -Dm600 ${../config/codex/config.toml} "$HOME/.codex/config.toml"
    fi
  '';
}
