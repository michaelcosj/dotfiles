#!/usr/bin/env bash
# Bump nix/pkgs/<name>.nix (a package built with pkgs/npm-binary.nix) to its latest
# npm release, or to the version given as $2, filling in each platform's hash from
# the npm registry. Then nix-rebuild.
#
#   update-npm-binary                  # update all npm binary packages
#   update-npm-binary opencode
#   update-npm-binary vite-plus 1.0.0
set -euo pipefail

# Sets one platform's hash (the line after its suffix) or the version, in
# place. awk instead of `sed -i`, whose syntax differs on macOS and Linux.
set_field() {
  local tmp
  tmp=$(mktemp)
  awk -v suffix="$2" -v value="$3" '
    suffix == "" && /^  version = ".*";$/ { sub(/".*"/, "\"" value "\"") }
    after_suffix && /hash = ".*";/ { sub(/".*"/, "\"" value "\""); after_suffix = 0 }
    suffix != "" && index($0, "suffix = \"" suffix "\";") { after_suffix = 1 }
    { print }
  ' "$1" >"$tmp" && mv "$tmp" "$1"
}

if [ $# -gt 2 ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  echo "usage: update-npm-binary [<name> [version]]"
  echo "With no name, update all npm binary packages."
  if [ $# -gt 2 ]; then exit 1; fi
  exit 0
fi

if [ $# -eq 0 ]; then
  for file in "$HOME"/.dotfiles/nix/pkgs/*.nix; do
    if grep -qF 'callPackage ./npm-binary.nix' "$file"; then
      name=${file##*/}
      bash "$0" "${name%.nix}"
    fi
  done
  exit 0
fi

file="$HOME/.dotfiles/nix/pkgs/$1.nix"
[ -f "$file" ] || { echo "no such package: $file" >&2; exit 1; }

prefix=$(sed -n 's/^  packagePrefix = "\(.*\)";/\1/p' "$file")
current=$(sed -n 's/^  version = "\(.*\)";/\1/p' "$file")
mapfile -t suffixes < <(sed -n 's/^ *suffix = "\(.*\)";/\1/p' "$file")
registry="https://registry.npmjs.org/$prefix"

version="${2:-$(curl -fsSL "$registry-${suffixes[0]}/latest" | jq -r .version)}"

if [ "$version" = "$current" ]; then
  echo "$1 is already at $version"
  exit 0
fi

# Fetch every platform before changing this package's pins.
hashes=()
for suffix in "${suffixes[@]}"; do
  hash=$(curl -fsSL "$registry-$suffix/$version" | jq -r .dist.integrity)
  if [ -z "$hash" ] || [ "$hash" = "null" ]; then
    echo "no $suffix build found for $1 $version" >&2
    exit 1
  fi
  hashes+=("$hash")
done
for i in "${!suffixes[@]}"; do
  set_field "$file" "${suffixes[$i]}" "${hashes[$i]}"
done
set_field "$file" "" "$version"

echo "$1 $current -> $version. Run nix-rebuild to install it."
