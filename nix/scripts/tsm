#!/usr/bin/env bash
set -e

usage() {
  printf '%s\n' \
    'Usage: tsm [PATH | -l | --list | --worktree | -h | --help]' \
    '' \
    'Commands:' \
    '  PATH        Create or switch to a tmux session for PATH.' \
    '  -l, --list  Pick from existing tmux sessions.' \
    '  --worktree  Pick from git worktrees for the current repository.' \
    '  -h, --help  Show this help message.' \
    '' \
    'Without arguments, pick from configured directories or defaults.'
}

in_tmux() {
  [ -n "$TMUX" ]
}

switch_or_attach() {
  local session=$1

  if in_tmux; then
    tmux switch-client -t "$session"
  else
    tmux attach-session -t "$session"
  fi
}

new_or_switch_session() {
  local path=$1
  local name

  path=$(realpath "$path")
  name=$(basename "$path" | tr . _ | tr : _)

  if ! tmux has-session -t="$name" 2>/dev/null; then
    if [ ! -d "$path" ]; then
      path="/tmp/$name"
      mkdir -p "$path"
    fi

    if in_tmux; then
      tmux new-session -d -s "$name" -c "$path"
      tmux switch-client -t "$name"
    else
      tmux new-session -s "$name" -c "$path"
    fi
    return
  fi

  switch_or_attach "$name"
}

pick_session() {
  local current_session session

  if in_tmux; then
    current_session=$(tmux display-message -p '#S')
    session=$(tmux list-sessions | cut -d ':' -f 1 | grep -v "^${current_session}$" | fzf)
  else
    session=$(tmux list-sessions | cut -d ':' -f 1 | fzf)
  fi

  if [ -n "$session" ]; then
    switch_or_attach "$session"
  fi
}

configured_dirs() {
  local config=$HOME/.dotfiles/nix/config/tsm/directories

  if [ -f "$config" ]; then
    sed "s|~|$HOME|g" "$config"
  else
    printf '%s\n' "$HOME/Projects" "$HOME/.dotfiles"
  fi
}

dir_options() {
  local dir

  while IFS= read -r dir; do
    if [ -d "$dir" ]; then
      printf '%s\n' "$dir"
      fd . "$dir" --max-depth 1 --type d --exclude node_modules 2>/dev/null
    fi
  done
}

pick_path() {
  configured_dirs | dir_options | sort -u | fzf --preview='ls {}'
}

pick_worktree() {
  if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
    printf '%s\n' 'Not in a git repository' >&2
    exit 1
  fi

  git worktree list --porcelain |
    while IFS= read -r line; do
      if [[ $line == worktree\ * ]]; then
        printf '%s\n' "${line#worktree }"
      fi
    done |
    fzf --preview='git -C {} status --short --branch'
}

main() {
  local arg=${1:-}
  local path

  case "$arg" in
    -h|--help)
      usage
      ;;
    -l|--list)
      pick_session
      ;;
    --worktree)
      path=$(pick_worktree)
      if [[ -n $path ]]; then
        new_or_switch_session "$path"
      fi
      ;;
    '')
      path=$(pick_path)
      if [[ -n $path ]]; then
        new_or_switch_session "$path"
      fi
      ;;
    *)
      new_or_switch_session "$arg"
      ;;
  esac
}

main "$@"
